# Keep these values on the server only. Do not use the VITE_ prefix.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
# First administrator: a personal chat, group, or channel ID that receives applications.
TELEGRAM_CHAT_ID=replace_with_your_chat_id
# Optional additional administrators, separated by commas.
TELEGRAM_CHAT_IDS=replace_with_additional_chat_ids
# Secret used by Telegram to authenticate webhook calls to /api/telegram-webhook.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret
# Added automatically after connecting a Vercel Blob store. Keeps dynamically added admins.
BLOB_READ_WRITE_TOKEN=provided_by_vercel_blob
APPLICATION_BOT_TOKEN=replace_with_the_questionnaire_bot_token
APPLICATION_BOT_WEBHOOK_SECRET=replace_with_a_second_long_random_secret
